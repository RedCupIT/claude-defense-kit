{
  "exactMatches": [
    ".env",
    ".envrc",
    "credentials",
    "secrets",
    ".pgpass",
    ".my.cnf",
    ".netrc",
    ".npmrc",
    ".pypirc",
    ".gemrc",
    ".htpasswd",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    "id_dsa",
    "kubeconfig",
    "vault-token"
  ],
  "patterns": [
    "^\\.env\\..*$",
    "^.*\\.env$",
    "^secrets?\\.ya?ml$",
    "^secrets?\\.json$",
    "^credentials?\\.json$",
    "^credentials?\\.ya?ml$",
    "^service[_-]?account.*\\.json$",
    "^.*[_-]?key\\.pem$",
    "^.*[_-]?key\\.json$",
    "^terraform\\.tfvars$",
    "^.*\\.tfstate$",
    "^.*[_-]?token$",
    "^.*[_-]?secret.*$",
    "^.*[_-]?password.*$",
    "^.*[_-]?apikey.*$",
    "^.*[_-]?api[_-]?key.*$"
  ],
  "descriptions": {
    ".env": "Environment variables file",
    "credentials": "Generic credentials file",
    "secrets": "Secrets configuration",
    "id_rsa": "RSA SSH private key",
    "id_ed25519": "Ed25519 SSH private key",
    "kubeconfig": "Kubernetes configuration",
    ".pgpass": "PostgreSQL password file",
    ".my.cnf": "MySQL configuration with credentials",
    ".npmrc": "npm authentication configuration",
    ".pypirc": "PyPI authentication configuration"
  }
}
