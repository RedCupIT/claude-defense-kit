{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Defense Kit",
  "identifier": "com.gobeyondidentity.claude-defense-kit",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "npm run bundle-server",
    "beforeDevCommand": "npm run build",
    "frontendDist": "./index.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Defense Kit",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; connect-src 'self' http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/*": "data/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": "localhost"
    },
    "externalBin": [
      "binaries/cdk-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
